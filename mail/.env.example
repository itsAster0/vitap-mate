# The mail Worker's settings. CONVEX_URL and FALLBACK_FORWARD are vars in
# wrangler.toml; MAIL_TOKEN is a secret (`wrangler secret put MAIL_TOKEN`).
# For `wrangler dev`, put them in .dev.vars (gitignored).
CONVEX_URL=https://vmate3.aster0.dev
# The same value as MAIL_TOKEN in the Convex deployment's env.
MAIL_TOKEN=replace-with-a-long-random-token
# Where mail to unknown addresses goes; empty rejects it.
FALLBACK_FORWARD=
