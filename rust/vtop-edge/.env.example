# For `bun run deploy` / `bun run plan` (alchemy.run.ts). Copy to .env; never commit it.
# Cloudflare login is in Alchemy's profile: `bun x alchemy profile edit --profile default --add Cloudflare`
# (OAuth in the browser, or an API token with Workers, Workers Routes and Zone read).

# Railway account token (railway.com → Account → Tokens).
RAILWAY_API_TOKEN=
# Shared by the edge, the engine and the UDP gateway: `openssl rand -hex 32`.
INTERNAL_TOKEN=
# The engine's vault key, 32 bytes base64: `openssl rand -base64 32`.
VAULT_KEY=
# Firebase service account JSON (one line) for FCM, project vitap-mate-self.
FIREBASE_CREDENTIALS_JSON=

# Gateway: the Docker host on the VPS, and a GitHub token that can push to GHCR
# (classic PAT with write:packages; CI uses its own GITHUB_TOKEN).
GATEWAY_SSH=ssh://rocky@robin
GHCR_USERNAME=itsAster0
GHCR_TOKEN=
