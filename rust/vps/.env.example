# The gateway's settings on the VPS: copy to .env (kept only on the VPS).
# Its Noise keys come from the edge (a new one every week).

# The engine.
ENGINE_URL=https://engine.example.com
# The engine's relay secret: its MAIL_RELAY_SECRET (the edge's BRIDGE_SECRET).
BRIDGE_SECRET=replace-me
# Fetches the keys from the edge (the edge's GATEWAY_SECRET; not the engine's).
GATEWAY_SECRET=replace-me
EDGE_URL=https://vmate-api.aster0.dev
BIND=0.0.0.0
# UDP 443 is Dokploy's Traefik's (HTTP/3) on this host.
PORTS=3478,51820,8443
RUST_LOG=warn,vtop_gateway=info
