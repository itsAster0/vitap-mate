# The engine (vtop-bridge), deployed to the Railway service engine-v2 by
# rust/vtop-edge/alchemy.run.ts (`bun run deploy`) with this folder as context.
FROM rust:1.98-slim-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --locked --profile server --package vtop-bridge --bin vtop-bridge \
    && cp target/server/vtop-bridge /vtop-bridge

FROM debian:bookworm-slim
# TLS uses rustls with built-in roots: no system certificates needed.
COPY --from=build /vtop-bridge /usr/local/bin/vtop-bridge
ENV PORT=8080 RUST_LOG=info
EXPOSE 8080
CMD ["vtop-bridge"]
