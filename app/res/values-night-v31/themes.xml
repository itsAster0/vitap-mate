<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- As values-night/themes.xml, plus the animated splash icon. The splash still leaves on the first frame. -->
  <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">#FF0A0A0A</item>
    <item name="android:windowSplashScreenBackground">#FF0A0A0A</item>
    <item name="android:windowSplashScreenIconBackgroundColor">#FF3A31AE</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="android:windowSplashScreenAnimationDuration">720</item>
  </style>
</resources>
