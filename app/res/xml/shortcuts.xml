<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon: open a feature directly (MainActivity reads the "open" extra). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
      android:shortcutId="timetable"
      android:icon="@drawable/shortcut_timetable"
      android:shortcutShortLabel="@string/shortcut_timetable">
    <intent
        android:action="android.intent.action.VIEW"
        android:targetPackage="com.vitap_pal.app"
        android:targetClass="vitapmate.MainActivity">
      <extra android:name="open" android:value="timetable" />
    </intent>
  </shortcut>
  <shortcut
      android:shortcutId="attendance"
      android:icon="@drawable/shortcut_attendance"
      android:shortcutShortLabel="@string/shortcut_attendance">
    <intent
        android:action="android.intent.action.VIEW"
        android:targetPackage="com.vitap_pal.app"
        android:targetClass="vitapmate.MainActivity">
      <extra android:name="open" android:value="attendance" />
    </intent>
  </shortcut>
  <shortcut
      android:shortcutId="outing"
      android:icon="@drawable/shortcut_outing"
      android:shortcutShortLabel="@string/shortcut_outing">
    <intent
        android:action="android.intent.action.VIEW"
        android:targetPackage="com.vitap_pal.app"
        android:targetClass="vitapmate.MainActivity">
      <extra android:name="open" android:value="outing" />
    </intent>
  </shortcut>
</shortcuts>
