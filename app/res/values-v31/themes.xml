<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- As values/themes.xml, plus the animated splash icon. The splash still leaves on the first frame. -->
  <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">#FFF5F5F6</item>
    <item name="android:windowSplashScreenBackground">#FFF5F5F6</item>
    <item name="android:windowSplashScreenIconBackgroundColor">@color/icon_yellow</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    <item name="android:windowSplashScreenAnimationDuration">720</item>
  </style>
</resources>
