<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon (API 31+): the card pops in, the mascot peeks over it, the lines fill, a blink. ~720 ms. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_mascot">
  <target android:name="head" android:animation="@animator/splash_head" />
  <target android:name="tilt" android:animation="@animator/splash_tilt" />
  <target android:name="card" android:animation="@animator/splash_card" />
  <target android:name="hands" android:animation="@animator/splash_hands" />
  <target android:name="line1" android:animation="@animator/splash_line1" />
  <target android:name="line2" android:animation="@animator/splash_line2" />
  <target android:name="line3" android:animation="@animator/splash_line3" />
  <target android:name="eye" android:animation="@animator/splash_blink" />
</animated-vector>
