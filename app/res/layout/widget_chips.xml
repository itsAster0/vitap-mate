<?xml version="1.0" encoding="utf-8"?>
<!-- TimetableWidget: the room with a pin and, while a class is on, its end time, as chips. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_chips"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="5dp">

  <LinearLayout
      android:id="@+id/widget_room_chip"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_chip"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="7dp"
      android:paddingTop="2dp"
      android:paddingEnd="7dp"
      android:paddingBottom="2dp">
    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/widget_pin"
        android:tint="@color/widget_on_primary_container"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/widget_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/widget_on_primary_container" />
  </LinearLayout>

  <!-- A gap between the chips (widgets can't use Space). -->
  <FrameLayout
      android:id="@+id/widget_chip_gap"
      android:layout_width="5dp"
      android:layout_height="1dp" />

  <TextView
      android:id="@+id/widget_ends"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/widget_chip"
      android:fontFamily="sans-serif-medium"
      android:maxLines="1"
      android:paddingStart="7dp"
      android:paddingTop="2dp"
      android:paddingEnd="7dp"
      android:paddingBottom="2dp"
      android:textColor="@color/widget_on_primary_container" />
</LinearLayout>
