<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- HttpEngine (Developer → HttpEngine) watches the network; without it, it crashes on start. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Downloads/vitapmate below API 29 (MediaStore takes over from 29). -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
  <!-- Device auth before the Account page (platform BiometricPrompt). -->
  <uses-permission android:name="android.permission.USE_BIOMETRIC" />
  <!-- Background sync's change notifications (asked for when it is turned on, Android 13+). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Live updates (LiveUpdates.kt, Android 16+): promoted ongoing notifications; re-armed after a reboot. -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- In class (ClassMode.kt): the app's own Do Not Disturb rule, once the student allows it. -->
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
  <!-- Gmail sign-in keeps the app awake while the student is in the browser (SignInService.kt). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <application
      android:label="Vitap Mate"
      android:icon="@mipmap/launcher_icon"
      android:enableOnBackInvokedCallback="true"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:fullBackupContent="@xml/backup_rules">
    <activity
        android:name="vitapmate.MainActivity"
        android:exported="true"
        android:windowSoftInputMode="adjustResize"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
      <!-- Android's Modes opens the app from the "In class" rule (ClassMode.kt). -->
      <intent-filter>
        <action android:name="android.app.action.AUTOMATIC_ZEN_RULE" />
      </intent-filter>
    </activity>
    <!-- The launcher entries, one for each app icon; AppIcon.kt keeps exactly one enabled (yellow at first).
         Each carries the long-press shortcuts: Timetable, Attendance, Outing. -->
    <activity-alias
        android:name="vitapmate.IconYellow"
        android:targetActivity="vitapmate.MainActivity"
        android:icon="@mipmap/launcher_icon"
        android:enabled="true"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
    </activity-alias>
    <activity-alias
        android:name="vitapmate.IconOrange"
        android:targetActivity="vitapmate.MainActivity"
        android:icon="@mipmap/launcher_icon_orange"
        android:enabled="false"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
    </activity-alias>
    <activity-alias
        android:name="vitapmate.IconGreen"
        android:targetActivity="vitapmate.MainActivity"
        android:icon="@mipmap/launcher_icon_green"
        android:enabled="false"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
    </activity-alias>
    <activity-alias
        android:name="vitapmate.IconBlue"
        android:targetActivity="vitapmate.MainActivity"
        android:icon="@mipmap/launcher_icon_blue"
        android:enabled="false"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
    </activity-alias>
    <activity-alias
        android:name="vitapmate.IconWhite"
        android:targetActivity="vitapmate.MainActivity"
        android:icon="@mipmap/launcher_icon_white"
        android:enabled="false"
        android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
    </activity-alias>
    <!-- A change notification's "Mark as seen" (BackgroundSync.kt). -->
    <receiver android:name="vitapmate.SeenReceiver" android:exported="false" />
    <!-- Live updates' class alarm and In class's, and re-arming them after a reboot or an update (LiveUpdates.kt). -->
    <receiver android:name="vitapmate.LiveUpdateReceiver" android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <!-- Push from the edge: new FCM tokens and messages (PushService.kt). -->
    <service android:name="vitapmate.PushService" android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>
    <!-- Gmail sign-in: awake until Google's redirect and the token exchange, 3 minutes at most. -->
    <service android:name="vitapmate.data.SignInService" android:exported="false" android:foregroundServiceType="shortService" />
    <!-- Settings → Assistant: app functions for Android's assistant (AssistantFunctions.kt generates the class and the XML). -->
    <service
        android:name="vitapmate.VitapmateFunctions"
        android:exported="true"
        android:permission="android.permission.BIND_APP_FUNCTION_SERVICE">
      <property android:name="android.app.appfunctions.v2" android:value="vitapmate_functions.xml" />
      <intent-filter>
        <action android:name="android.app.appfunctions.AppFunctionService" />
      </intent-filter>
    </service>
    <!-- Home-screen widget: next class and today's timetable (TimetableWidget.kt). -->
    <receiver android:name="vitapmate.TimetableWidgetReceiver" android:exported="true" android:label="@string/shortcut_timetable">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/timetable_widget" />
    </receiver>
    <!-- Shares the log file from the Inspector (share sheet). -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="com.vitap_pal.app.logs"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/log_paths" />
    </provider>
  </application>
</manifest>
