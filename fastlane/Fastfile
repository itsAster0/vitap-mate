default_platform(:android)

# Paths are from the repo root (fastlane runs there); `sh` runs in fastlane/.
AAB = 'build/vitapmate-release.aab'.freeze
METADATA = 'fastlane/metadata/android'.freeze
# Play's in-app update priority (0-5, see PlayUpdate.kt): the default, then any release that differs, by versionCode.
DEFAULT_UPDATE_PRIORITY = 3
UPDATE_PRIORITIES = {
  # 3001000 => 5,
}.freeze

# The versionCode the AAB is built with, from app/module.yaml.
def version_code
  File.read(File.expand_path('../app/module.yaml', __dir__))[/^\s*versionCode:\s*(\d+)/, 1] or
    UI.user_error!('no versionCode in app/module.yaml')
end

def update_priority
  UPDATE_PRIORITIES.fetch(version_code.to_i, DEFAULT_UPDATE_PRIORITY).tap do |p|
    UI.user_error!("update priority must be 0 to 5, not #{p}") unless (0..5).cover?(p)
  end
end

platform :android do
  desc 'Build (`mise run bundle`, skip with build:false) and upload the AAB to internal, with changelogs/<versionCode>.txt'
  lane :deploy_internal do |options|
    sh('cd .. && mise run bundle') unless [false, 'false'].include?(options[:build])
    code = version_code
    missing = Dir["#{METADATA}/*/"].reject { |dir| File.exist?("#{dir}changelogs/#{code}.txt") }
    UI.user_error!("no changelogs/#{code}.txt in #{missing.join(', ')}") unless missing.empty?
    upload_to_play_store(
      track: 'internal',
      aab: AAB,
      metadata_path: METADATA,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      in_app_update_priority: update_priority
    )
  end

  desc 'Promote the latest internal build to the closed (friends), alpha and beta tracks'
  lane :promote_all do
    %w[friends alpha beta].each do |track|
      upload_to_play_store(
        track: 'internal',
        track_promote_to: track,
        skip_upload_changelogs: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        in_app_update_priority: update_priority
      )
    end
    # Production stays a manual step in the Play Console.
  end

  desc 'Build, upload to internal, then promote through the testing tracks'
  lane :deploy_all do
    deploy_internal
    promote_all
  end
end
