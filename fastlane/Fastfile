default_platform(:android)

# Paths are from the repo root (fastlane runs there); `sh` runs in fastlane/.
AAB = 'build/vitapmate-release.aab'.freeze
METADATA = 'fastlane/metadata/android'.freeze
# Play's in-app update priority (0-5, see PlayUpdate.kt): the default, then any release that differs, by versionCode.
DEFAULT_UPDATE_PRIORITY = 2
UPDATE_PRIORITIES = {
  # 3001000 => 5,
  3_002_000 => 5, # the new server: older versions stop syncing
  3_002_100 => 3 # hung OTP sign-ins, Keystore password, no stored session: ask once on start
}.freeze

# The versionCode the AAB is built with, from app/module.yaml.
def version_code
  File.read(File.expand_path('../app/module.yaml', __dir__))[/^\s*versionCode:\s*(\d+)/, 1] or
    UI.user_error!('no versionCode in app/module.yaml')
end

def update_priority
  UPDATE_PRIORITIES.fetch(version_code.to_i, DEFAULT_UPDATE_PRIORITY).tap do |p|
    UI.user_error!("update priority must be 0 to 5, not #{p}") unless (0..5).cover?(p)
  end
end

# The closed tracks a build goes through before production.
TESTING_TRACKS = %w[friends alpha beta].freeze

# A staged rollout's share of users, as Play takes it: more than 0, at most 1.
def rollout_fraction(value)
  fraction = Float(value.to_s, exception: false)
  UI.user_error!("rollout must be more than 0 and at most 1, not #{value}") unless fraction&.positive? && fraction <= 1
  fraction.to_s
end

platform :android do
  desc 'Build (`mise run bundle`, skip with build:false) and upload the AAB to internal, with changelogs/<versionCode>.txt'
  lane :upload_internal do |options|
    sh('cd .. && mise run bundle') unless [false, 'false'].include?(options[:build])
    code = version_code
    missing = Dir["#{METADATA}/*/"].reject { |dir| File.exist?("#{dir}changelogs/#{code}.txt") }
    UI.user_error!("no changelogs/#{code}.txt in #{missing.join(', ')}") unless missing.empty?
    upload_to_play_store(
      track: 'internal',
      aab: AAB,
      metadata_path: METADATA,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      in_app_update_priority: update_priority
    )
  end

  desc 'Promote the latest internal build to the closed (friends), alpha and beta tracks'
  lane :promote_testing do
    # Production is its own lane (promote_production), never part of testing.
    TESTING_TRACKS.each do |track|
      upload_to_play_store(
        track: 'internal',
        track_promote_to: track,
        skip_upload_changelogs: true,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        in_app_update_priority: update_priority
      )
    end
  end

  desc 'upload_internal, then promote_testing: one build on internal, friends, alpha and beta (never production)'
  lane :upload_testing do |options|
    upload_internal(options)
    promote_testing
  end

  desc 'upload_testing, then promote_production: one build on every track, production as a staged rollout (rollout:0.2 by default)'
  lane :upload_all do |options|
    rollout = rollout_fraction(options[:rollout] || '1') # checked before anything uploads
    upload_testing(options)
    promote_production(rollout: rollout)
  end

  desc 'Promote the beta build to production as a staged rollout (rollout:0.2 by default)'
  lane :promote_production do |options|
    upload_to_play_store(
      track: 'beta',
      track_promote_to: 'production',
      rollout: rollout_fraction(options[:rollout] || '0.2'),
      skip_upload_changelogs: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      in_app_update_priority: update_priority
    )
  end

  desc "Widen production's staged rollout (rollout:0.5), or rollout:1 for everyone"
  lane :widen_rollout do |options|
    UI.user_error!('widen_rollout needs a fraction, such as rollout:0.5') unless options[:rollout]
    upload_to_play_store(
      track: 'production',
      rollout: rollout_fraction(options[:rollout]),
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc 'Show the release on each track (version and code); uploads nothing'
  lane :status do
    rows = (['internal'] + TESTING_TRACKS + ['production']).map do |track|
      codes = google_play_track_version_codes(track: track)
      names = google_play_track_release_names(track: track)
      [track, names.join(', ').then { |n| n.empty? ? '-' : n }, codes.join(', ').then { |c| c.empty? ? '-' : c }]
    end
    puts Terminal::Table.new(title: "Play tracks (this checkout: #{version_code})", headings: %w[Track Version Code], rows: rows)
  end
end
