{
  // Catch-all Email Worker for aster0.dev. See src/index.js.
  "name": "vitapmate-mail-otp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
    "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "BRIDGE_URL": "https://vtop-bridge-production.up.railway.app"
    // FALLBACK_FORWARD (optional): where other @aster0.dev mail goes.
    // Unset, it is rejected, as it was before the catch-all pointed here.
  }
  // Secret: RELAY_SECRET (same value as the bridge's MAIL_RELAY_SECRET).
}
