# For `bun run deploy` / `bun run plan` (alchemy.run.ts). Copy to .env; never commit it.
# Cloudflare login is in Alchemy's profile: `bun x alchemy profile edit --profile default --add Cloudflare`
# (OAuth in the browser, or an API token with Workers, Workers Routes and Zone read).
# The v3 secrets (INTERNAL_TOKEN, GATEWAY_TOKEN, MAIL_TOKEN and VERIFIER_TOKEN for
# the engine, the gateway, the mail Worker and the TLSNotary verifiers on hawk and nest)
# are read from the Convex deployment's env at deploy time, with ../backend/.env.local.

# The engine's vault key, 32 bytes base64 (`openssl rand -base64 32`). The v2 engine's, so
# vaults and sessions sealed on v2 still open; changing it makes every saved one unusable.
VAULT_KEY=

# hawk, the Docker host for Convex, the engine, the verifier and the gateway, and a GitHub
# token that can push their images to GHCR (classic PAT with write:packages; CI uses its own GITHUB_TOKEN).
GATEWAY_SSH=ssh://root@172.232.115.40
# Where the engine, verifier and gateway images build (and where the standby verifier runs):
# nest, an x86_64 machine on NetBird.
GATEWAY_BUILDER=ssh://root@nest.netbird.cloud
GHCR_USERNAME=itsAster0
GHCR_TOKEN=
