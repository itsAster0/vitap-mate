{
  "manifest_version": 3,
  "name": "VITAP Mate – VTOP Sign In",
  "version": "1.2.0",
  "description": "Sign in to VTOP securely using the Token from the VITAP Mate app.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "VITAP Mate"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs", "cookies", "sidePanel"],
  "host_permissions": ["https://vtop.vitap.ac.in/*", "https://be-va.kryxen.dev/*", "https://vtop-bridge-production.up.railway.app/*"],
  "content_scripts": [
    {
      "matches": ["https://vtop.vitap.ac.in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
