# For `bun run deploy` / `bun run plan` (alchemy.run.ts). Copy to .env; never commit it.
# Cloudflare login is in Alchemy's profile: `bun x alchemy profile edit --profile default --add Cloudflare`
# (OAuth in the browser, or an API token with Workers, Workers Routes and Zone read).

# Railway account token (railway.com → Account → Tokens).
RAILWAY_API_TOKEN=
# The v3 secrets (INTERNAL_TOKEN, GATEWAY_TOKEN, MAIL_TOKEN for the engine, the gateway
# and the mail Worker) are read from the Convex deployment's env at deploy time, with
# ../backend/.env.local. The two below are the frozen v2 edge's own.
# Shared by the v2 edge and the v2 engine: `openssl rand -hex 32`.
INTERNAL_TOKEN=
# The UDP gateway's own, a different value: `openssl rand -hex 32`.
GATEWAY_TOKEN=
# Signs the edge's account tokens (HS256): `openssl rand -hex 32`. Changing it
# signs every phone out of its token (each sends its VTOP session once more).
ACCOUNT_TOKEN_SECRET=
# The engine's vault key, 32 bytes base64: `openssl rand -base64 32`.
VAULT_KEY=
# Firebase service account JSON (one line) for FCM, project vitap-mate-self.
FIREBASE_CREDENTIALS_JSON=

# Gateway: the Docker host on the VPS, and a GitHub token that can push to GHCR
# (classic PAT with write:packages; CI uses its own GITHUB_TOKEN).
GATEWAY_SSH=ssh://root@172.232.115.40
# Where the gateway image builds: nest, an x86_64 machine on NetBird.
GATEWAY_BUILDER=ssh://root@nest.netbird.cloud
GHCR_USERNAME=itsAster0
GHCR_TOKEN=
