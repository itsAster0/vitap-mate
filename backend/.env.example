# Convex deployment env (set with `bunx convex env set NAME value`). Placeholders only.
# `bun dev/gen-test-env.ts` makes fresh test values in .env.test.local.

# Every value here is required except those marked unset-able: no defaults in code.
# Access JWT (ES256), issued under PUBLIC_URL. JWT_PUBLIC_JWK is a data: URI holding the JWKS,
# read by auth.config.ts.
JWT_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","kid":"..."}
JWT_PUBLIC_JWK=data:text/plain;charset=utf-8;base64,...

# Bearer tokens of the internal HTTP routes: the engine, the mail Worker, the UDP gateway,
# and the TLSNotary verifier (rust/vtop-verifier; /internal/proof-ticket and -done only).
INTERNAL_TOKEN=change-me
MAIL_TOKEN=change-me
GATEWAY_TOKEN=change-me
VERIFIER_TOKEN=change-me

# Checks v2 account tokens traded in during the migration (the edge's secret).
ACCOUNT_TOKEN_SECRET=change-me

# The engine (vtop-bridge) and this backend's public URL.
ENGINE_URL=http://engine.internal:8090
PUBLIC_URL=https://vmate.example.dev

# CORS origins for the key routes (comma separated; empty allows all).
ALLOWED_ORIGINS=
# The forwarding address domain.
MAIL_DOMAIN=vmate.example.dev
# Proxies in front of Convex that each append the address they saw to X-Forwarded-For
# (1 for hawk's Caddy alone). Required; must be a positive integer.
PROXY_HOPS=1
# Unset-able: the Proxy route's Worker (proxy/), handed to phones by proxy:info; unset turns
# the route off.
PROXY_URL=https://vmate-proxy.example
# Unset-able: the FCM service account JSON. Unset, no push is sent.
FIREBASE_CREDENTIALS_JSON=
# Optional test override for Google's FCM API origin (unset or empty uses https://fcm.googleapis.com).
FCM_URL=

# Local only (.env.local, not the deployment): where `bunx convex` deploys.
CONVEX_SELF_HOSTED_URL=https://vmate.example.dev
CONVEX_SELF_HOSTED_ADMIN_KEY=change-me
